<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de hoy arriba (en jade, como en Inicio) y debajo la tarjeta a evitar y el próximo
     pago. Los textos y colores los pone TinoWidgetProvider con el resumen de la app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_raiz"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_fondo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/tino_widget_fondo" />

  <TextView
    android:id="@+id/widget_mensaje"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="16dp"
    android:text="@string/tino_widget_sin_datos"
    android:textColor="@color/tino_widget_texto"
    android:textSize="15sp" />

  <LinearLayout
    android:id="@+id/widget_contenido"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:visibility="gone">

    <!-- Ocupa el alto que sobra, así el widget no queda con un hueco abajo. -->
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

      <ImageView
        android:id="@+id/widget_bloque_fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/tino_widget_bloque" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp" />

          <TextView
            android:id="@+id/widget_alias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="16sp"
            android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:gravity="end"
          android:orientation="vertical">

          <TextView
            android:id="@+id/widget_dias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textSize="32sp"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/widget_dias_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="11sp" />
        </LinearLayout>
      </LinearLayout>
    </FrameLayout>

    <TextView
      android:id="@+id/widget_evitar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingHorizontal="4dp"
      android:textSize="13sp"
      android:textStyle="bold"
      android:visibility="gone" />

    <TextView
      android:id="@+id/widget_pago"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingHorizontal="4dp"
      android:textSize="13sp"
      android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
